{
  "name": "@wissen-haus/api",
  "version": "1.0.0",
  "description": "Wissen-Haus API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc && cp -r src/db/migrations dist/db/migrations || true",
    "start": "node -r module-alias/register dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "migrate": "node -r ts-node/register -r tsconfig-paths/register src/scripts/migrate.ts",
    "migrate:dev": "npm run migrate",
    "seed": "node -r ts-node/register -r tsconfig-paths/register src/scripts/seed.ts"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.0",
    "axios": "^1.6.5",
    "bcrypt": "^5.1.1",
    "bull": "^4.11.5",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.3.4",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "stripe": "^14.18.0",
    "twilio": "^4.10.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}

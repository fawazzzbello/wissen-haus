# Server Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wissen_haus_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wissen_haus_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@wissen-haus.org
SENDGRID_FROM_NAME=Wissen-Haus

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Frontend
FRONTEND_URL=http://localhost:3000

# Redis (optional, for job queue)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug

# Email Configuration
ADMIN_EMAIL=admin@wissen-haus.org

# Notification Settings
SEND_DONATION_CONFIRMATION_EMAIL=true
SEND_DONATION_CONFIRMATION_SMS=false
SEND_HIGH_VALUE_SMS_ALERTS=true
HIGH_VALUE_DONATION_THRESHOLD=1000

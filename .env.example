# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wissen_haus_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wissen_haus_db

# Server Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:3000

# SendGrid Configuration
SENDGRID_API_KEY=SG.your_api_key_here

# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_key_here

# Twilio Configuration (optional)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379

# Application URLs
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_key_here

# Railway-specific (ignore these if not using Railway)
# PORT is automatically set by Railway
# DATABASE_URL should be set to your Railway database URL
